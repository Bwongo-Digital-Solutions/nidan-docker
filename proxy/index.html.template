<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ClinicEMR Services Portal</title>
  <link rel="icon" href="proxy/clinicemr-logo.svg" type="image/x-icon">
  <style>
    /* ==========================================================================
       1. Global Styles & CSS Variables
       ========================================================================== */
    :root {
      --bg-color: #dbe3ea;
      --card-bg: #ffffff;
      --card-hover-bg: #e9f4f4;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --primary-teal: #008080;

      --footer-bg: #008080;
      --footer-text: #ffffff;
      --footer-muted: rgba(255, 255, 255, 0.85);

      --status-online: #10b981;
      --status-offline: #ef4444;
      --status-checking: #f59e0b;
      --border-color: #e2e8f0;
      --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.03);
      --shadow-md: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
      --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
      width: 100%;
    }

    main {
      padding: 1rem 0 2rem;
      flex-grow: 1;
    }

    /* ==========================================================================
       2. Centered Brand Header
       ========================================================================== */
    .header {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      margin: 10px 0 15px;
    }

    .brand-logo {
      max-width: 240px;
      width: 100%;
      height: auto;
    }

    @media (max-width: 768px) {
      .brand-logo {
        max-width: 180px;
      }
    }

    /* ==========================================================================
       3. Hero & Square Cards Grid Layout
       ========================================================================== */
    .hero-container {
      text-align: center;
      margin-bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-title {
      font-size: 1.65rem;
      font-weight: 800;
      color: #0f172a;
      letter-spacing: -0.025em;
      line-height: 1.25;
      position: relative;
      display: inline-block;
    }

    .hero-title::after {
      content: '';
      display: block;
      width: 50px;
      height: 3px;
      background-color: var(--primary-teal);
      border-radius: 2px;
      margin: 0.5rem auto 0;
    }

    /* Strict 4-column grid layout */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      max-width: 1080px;
      margin: 0 auto;
    }

    /* Square Card Configuration */
    .card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      border: 1px solid transparent;
      box-shadow: var(--shadow-sm);
      transition: var(--transition-smooth);
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      aspect-ratio: 1 / 1;
      width: 100%;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: rgba(0, 128, 128, 0.35);
      background: var(--card-hover-bg);
    }

    .card:hover .card-title {
      color: var(--primary-teal);
    }

    /* Status Badges */
    .status-badge {
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      margin-bottom: 0.5rem;
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
    }

    .status-badge.status-checking {
      background-color: rgba(245, 158, 11, 0.1);
      color: var(--status-checking);
    }

    .status-badge.status-online {
      background-color: rgba(16, 185, 129, 0.1);
      color: var(--status-online);
    }

    .status-badge.status-offline {
      background-color: rgba(239, 68, 68, 0.1);
      color: var(--status-offline);
    }

    .icon-wrapper {
      width: 48px;
      height: 48px;
      font-size: 2.25rem;
      line-height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.5rem;
      transition: var(--transition-smooth);
    }

    .card:hover .icon-wrapper {
      transform: scale(1.06);
    }

    .icon-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .card.offline .icon-wrapper {
      pointer-events: none;
    }

    .card-title {
      font-size: 0.9rem;
      font-weight: 600;
      line-height: 1.25;
      margin-bottom: 0.25rem;
    }

    .card-description {
      font-size: 0.75rem;
      color: var(--text-muted);
      line-height: 1.2;
    }

    /* --------------------------------------------------------------------------
       Spacious Layout for Desktop/Large Screens (>= 1025px)
       -------------------------------------------------------------------------- */
    @media (min-width: 1025px) {
      main {
        padding: 2rem 0 3.5rem;
      }

      .header {
        margin-bottom: 2rem;
      }

      .hero-container {
        margin-bottom: 3rem;
      }
    }

    /* Responsive scaling for mobile & tablets */
    @media (max-width: 900px) {
      .cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 550px) {
      .cards-grid {
        grid-template-columns: 1fr;
      }

      .card {
        aspect-ratio: auto;
        padding: 1.25rem 1rem;
      }
    }

    /* ==========================================================================
       4. Footer Styles
       ========================================================================== */
    footer {
      background-color: var(--footer-bg);
      padding: 1rem 0;
      color: var(--footer-text);
      font-size: 0.85rem;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-left {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }

    .footer-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      gap: 0.25rem;
      flex-shrink: 0;
    }

    .footer-brand-link {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: none;
      color: inherit;
    }

    .footer-logo {
      height: 1em;
      width: auto;
      display: inline-block;
      vertical-align: middle;
    }

    .tech-powerhouse {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .tech-powerhouse-title {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--footer-text);
    }

    .tech-list-small {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: nowrap;
    }

    .tech-logo-small {
      max-height: 14px;
      width: auto;
      object-fit: contain;
      filter: brightness(0) invert(1);
      opacity: 0.85;
      transition: var(--transition-smooth);
    }

    .tech-logo-small:hover {
      opacity: 1;
      transform: scale(1.1);
    }

    .copyright-text {
      color: var(--footer-muted);
      font-size: 0.75rem;
    }

    @media (max-width: 768px) {
      .footer-content {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
      }

      .footer-left,
      .footer-right {
        align-items: center;
        text-align: center;
      }

      .tech-list-small {
        flex-wrap: wrap;
        justify-content: center;
      }
    }

    /* ==========================================================================
       5. Demo Credentials Modal
       ========================================================================== */
    .credential-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .55);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 30px;
      z-index: 9999;
    }

    .credential-modal.active {
      display: flex;
    }

    .credential-content {
      background: #fff;
      width: min(900px, 100%);
      border-radius: 16px;
      padding: 35px;
      position: relative;
      max-height: 90vh;
      overflow: auto;
    }

    .close-btn {
      position: absolute;
      right: 20px;
      top: 15px;
      border: none;
      background: none;
      font-size: 32px;
      cursor: pointer;
      line-height: 1;
    }

    .credential-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }

    .credential-item {
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 18px;
      background: #fafafa;
    }

    .credential-item h3 {
      margin: 0 0 15px;
      color: var(--primary-teal);
      font-size: 18px;
    }

    .credential-item span {
      display: block;
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 10px;
    }

    .credential-item code {
      display: block;
      background: #f0f3f5;
      border-radius: 6px;
      padding: 8px 10px;
      margin-top: 4px;
      font-weight: 600;
    }
  </style>
