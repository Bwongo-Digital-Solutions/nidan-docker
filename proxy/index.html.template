  </div>

  <script>
    const services = [
      { id: 'openmrs', url: '/openmrs/spa/config.json' },
      { id: 'openelis', url: '/openelis/' },
      { id: 'odoo', url: '/odoo-health/' },
      { id: 'orthanc', url: '/auth-ping/orthanc' },
      { id: 'cis', url: '/cis/actuator/health' },
      { id: 'superset', url: '/superset/' },
      { id: 'dhis2', url: '/dhis2/auth/login' }
    ];

    async function checkHealth() {
      for (const service of services) {
        const card = document.getElementById(`card-${service.id}`);
        const statusBadge = document.getElementById(`status-${service.id}`);
        if (!card || !statusBadge) continue;

        try {
          const response = await fetch(service.url, { method: 'GET', cache: 'no-cache' });
          // NGINX returns 502/503/504 when the upstream container is down or starting
          if (response.status === 502 || response.status === 503 || response.status === 504) {
            setOffline(card, statusBadge);
          } else {
            // Any other status (including 401/404 redirects) means the backend container answered
            setOnline(card, statusBadge);
          }
        } catch (error) {
          setOffline(card, statusBadge);
        }
      }
    }

    function setOnline(card, badge) {
      card.classList.remove('offline');
      badge.className = 'status-badge status-online';
      badge.innerText = 'Online';
    }

    function setOffline(card, badge) {
      card.classList.add('offline');
      badge.className = 'status-badge status-offline';
      badge.innerText = 'Offline';
    }

    // Run immediately, then poll every 15 seconds
    checkHealth();
    setInterval(checkHealth, 15000);
  </script>

  <!-- credential scripts -->
  <script>
    const credentialBtn = document.getElementById("credentialBtn");
    const credentialModal = document.getElementById("credentialModal");
    const closeCredential = document.getElementById("closeCredential");

    credentialBtn.addEventListener("click", function (e) {
      e.preventDefault();
      credentialModal.classList.add("active");
    });

    closeCredential.addEventListener("click", function () {
      credentialModal.classList.remove("active");
    });

    credentialModal.addEventListener("click", function (e) {
      if (e.target === credentialModal) {
        credentialModal.classList.remove("active");
      }
    });
  </script>
</body>

