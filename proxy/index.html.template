<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ClinicEMR-HIS</title>
    <link rel="icon" href="/assets/favicon.ico" type="image/x-icon">
    <style>
       :root {
            --bs-primary: #4a90e2;
             --nidan-global-color-secondary: #008080;
                 --nidan-global-color-white: #ffffff;
                 
        }

        @supports ( color: color( display-p3 0 0 0 / 1 ) ) {
            :root {
                 --nidan-global-color-secondary: color(display-p3 0.000000 0.501961 0.501961 / 1.000000);
                  --nidan-global-color-white: color(display-p3 1.000000 1.000000 1.000000 / 1.000000);
            }
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: #f4f6f8;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
        }

        .brand-logo {
            max-width: 140px;
            margin-bottom: 80px;
            margin-top: 40px;
            height: auto;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            max-width: calc(100% - 40px);
            width: 100%;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            text-decoration: none;
            color: #333;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s, box-shadow 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        }

        .icon {
            font-size: 3rem;
            margin-bottom: 15px;
        }

        .title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .desc {
            font-size: 0.9rem;
            color: #7f8c8d;
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-bottom: 10px;
            width: fit-content;
        }

        .status-online {
            background-color: #e8f5e9;
            color: #2e7d32;
        }

        .status-offline {
            background-color: #ffebee;
            color: #c62828;
        }

        .status-checking {
            background-color: #fff3e0;
            color: #ef6c00;
        }

        .card.offline  .icon{
            pointer-events: none;
        }
        .nidan-platforms-content{
            padding-bottom: 50px;
            padding-top: 100px;
            text-align: center;
        }
        .nidan-platforms-content h2 {
            font-size: 1.5rem;
            margin-bottom: 10px;
        }
        .nidan-platforms-content p {
            font-size: 1rem;
            color: #7f8c8d;
            margin-bottom: 30px;
        }
        .nidan-platforms {
            display: flex;
            gap: 1rem 2rem;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
        }
        .nidan-platforms > img {
             opacity: 0.85;
            filter: grayscale(1);
            max-width: 120px;
            height: inherit;
        }
        .nidan-platforms > img:hover,
        .nidan-platforms > img:focus {
            filter: none;
        }

        /* Footer Styling */
        footer {
            width: 100%;
            background:var(--nidan-global-color-secondary);
            color:  var(--nidan-global-color-white);
            padding: 30px 0;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-top: auto;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .footer-content {
            max-width: 1200px;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        .footer-text {
            font-size: 0.85rem;
            margin: 0;
            letter-spacing: 0.5px;
        }

        .footer-logo-container {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .footer-logo {
            height: 35px;
            opacity: 0.95;
            transition: opacity 0.3s;
        }

        .footer-logo:hover {
            opacity: 1;
        }

        .footer-copyright {
            font-size: 0.75rem;
            margin-top: 5px;
        }

        /* Mobile adjustment */
        @media (max-width: 600px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="main-content">
        <!-- Nidan Logo -->
        <img src="nidan-logo.png" alt="ClinicEMR -HIS" class="brand-logo">

        <div class="grid">
            <!-- OpenMRS -->
            <a href="/openmrs/spa/index.html" target="_blank" class="card" id="card-openmrs">
                <div class="status-badge status-checking" id="status-openmrs">Checking...</div>
                <div class="icon">🏥</div>
                <div class="title">Electronic Medical Record</div>
            </a>

            <!-- OpenELIS -->
            <a href="/openelis" target="_blank" class="card" id="card-openelis">
                <div class="status-badge status-checking" id="status-openelis">Checking...</div>
                <div class="icon">🔬</div>
                <div class="title">Laboratory Information System</div>
            </a>

            <!-- Odoo -->
            <a href="${DASHBOARD_ODOO_URL}" target="_blank" class="card" id="card-odoo">
                <div class="status-badge status-checking" id="status-odoo">Checking...</div>
                <div class="icon">📊</div>
                <div class="title">ERP & Inventory</div>
            </a>

            <!-- Orthanc -->
            <a href="/orthanc-container/ui/app/index.html#/" target="_blank" class="card" id="card-orthanc">
                <div class="status-badge status-checking" id="status-orthanc">Checking...</div>
                <div class="icon">🦴</div>
                <div class="title">PACS & Imaging (Explorer 2)</div>
            </a>

            <!-- Middleware UI -->
            <a href="/cis/dead-letters/index.html" target="_blank" class="card" id="card-cis">
                <div class="status-badge status-checking" id="status-cis">Checking...</div>
                <div class="icon">�</div>
                <div class="title">Integration & Error Management</div>
                <div class="desc"></div>
            </a>

            <!-- Superset -->
            <a href="/superset/" target="_blank" class="card" id="card-superset">
                <div class="status-badge status-checking" id="status-superset">Checking...</div>
                <div class="icon">📈</div>
                <div class="title">Analytics & Business Intelligence</div>
            </a>

            <!-- DHIS2 -->
            <a href="/dhis2/" target="_blank" class="card" id="card-dhis2">
                <div class="status-badge status-checking" id="status-dhis2">Checking...</div>
                <div class="icon">📡</div>
                <div class="title">Federal & Provincial HMIS Reporting</div>
            </a>
        </div>

        <div class="nidan-platforms-content">
            <h2>Powered by Industry-Leading Technologies</h2>
            <p>Leveraging powerful open-source and enterprise technologies to deliver reliable, scalable solutions.</p>
            <div class="nidan-platforms">
                <img src="assets/images/openmrs_logo.svg" alt="OpenMRS" title="OpenMRS" class="platform-logo">
                <img src="assets/images/OpenElisGlobalLogo.png" alt="OpenELIS" title="OpenELIS" class="platform-logo">
                <img src="assets/images/dhis2-logo.svg" alt="DHIS2" title="DHIS2" class="platform-logo">
                <img src="assets/images/OrthancLogo.png" alt="Orthanc" title="Orthanc" class="platform-logo">
                <img src="assets/images/odoo_logo.svg" alt="Odoo" title="Odoo" class="platform-logo">
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <p class="footer-text">Powered by</p>
            <div class="footer-logo-container">
                <img src="trigonal-logo.png" alt="Trigonal Technology" class="footer-logo">
            </div>
            <p class="footer-copyright">© 2026 NidanEHR. All rights reserved.</p>
        </div>
    </footer>

    <script>
        const services = [
            { id: 'openmrs', url: '/openmrs/spa/config.json' },
            { id: 'openelis', url: '/openelis/' },
            { id: 'odoo', url: '/odoo-health/' },
            { id: 'orthanc', url: '/auth-ping/orthanc' },
            { id: 'cis', url: '/cis/actuator/health' },
            { id: 'superset', url: '/superset/' },
            { id: 'dhis2', url: '/dhis2/auth/login' }
        ];

        async function checkHealth() {
            for (const service of services) {
                const card = document.getElementById(`card-${service.id}`);
                const statusBadge = document.getElementById(`status-${service.id}`);
                if (!card || !statusBadge) continue;

                try {
                    const response = await fetch(service.url, { method: 'GET', cache: 'no-cache' });
                    // NGINX returns 502/503/504 when the upstream container is down or starting
                    if (response.status === 502 || response.status === 503 || response.status === 504) {
                        setOffline(card, statusBadge);
                    } else {
                        // Any other status (including 401/404 redirects) means the backend container answered
                        setOnline(card, statusBadge);
                    }
                } catch (error) {
                    setOffline(card, statusBadge);
                }
            }
        }

        function setOnline(card, badge) {
            card.classList.remove('offline');
            badge.className = 'status-badge status-online';
            badge.innerText = 'Online';
        }

        function setOffline(card, badge) {
            card.classList.add('offline');
            badge.className = 'status-badge status-offline';
            badge.innerText = 'Offline';
        }

        // Run immediately, then poll every 15 seconds
        checkHealth();
        setInterval(checkHealth, 15000);
    </script>
</body>

</html>