# =============================================================================
# Nidan Docker — environment template
# Copy to .env and adjust. Variable names and section order match .env for easy diffing.
# =============================================================================

# -----------------------------------------------------------------------------
# Gateway & TLS (Let's Encrypt via certbot)
# -----------------------------------------------------------------------------
GATEWAY_IMAGE=trigonaltechnology/gateway:latest
GATEWAY_DOMAIN=localhost
# Extra hostnames/IPs to put in the self-signed certificate, comma separated.
# Whatever users type in the address bar must be listed or the browser warns.
# Leave blank when GATEWAY_DOMAIN is a real domain with a Let's Encrypt cert.
GATEWAY_CERT_SANS=
# Odoo link on the gateway dashboard (index.html Odoo card).
# Local: direct port. Cloud: public URL, e.g. https://ehr.example.com:8069
DASHBOARD_ODOO_URL=http://localhost:8069
CERTBOT_EMAIL=admin@example.com
CERTBOT_DOMAINS=localhost

# -----------------------------------------------------------------------------
# TLS trust / keystores (optional; FHIR or HTTPS clients)
# -----------------------------------------------------------------------------
SSL_TRUSTSTORE_PATH=
SSL_TRUSTSTORE_PASSWORD=
SSL_KEYSTORE_PATH=
SSL_KEYSTORE_PASSWORD=

# -----------------------------------------------------------------------------
# OpenMRS — MySQL + EMR API (CIS uses DB host for Debezium; REST below)
# -----------------------------------------------------------------------------
OPENMRS_DB_NAME=openmrs
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=openmrs
OPENMRS_DB_ROOT_PASSWORD=openmrs
OPENMRS_DB_HOST=openmrs-db
OPENMRS_DB_PORT=3306
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=1GB
OMRS_DEBUG=false

# REST / FHIR identifiers (nidan-cis → OpenMRS)
# CIS authenticates AND writes to OpenMRS as the dedicated sync account (NIDAN_SYNC_* below).
# This makes CIS's inbound (Odoo→OpenMRS) writes attributable so their CDC echoes are dropped
# (loop prevention). Keep these equal to NIDAN_SYNC_USERNAME / NIDAN_SYNC_PASSWORD.
OPENMRS_USERNAME=admin
OPENMRS_PASSWORD=Admin123
# Real OpenMRS admin — used ONLY by CIS at startup to bootstrap (create the sync account).
OPENMRS_ADMIN_USERNAME=admin
OPENMRS_ADMIN_PASSWORD=Admin123
OPENMRS_IDENTIFIER_TYPE_UUID=c0e1d2f3-a4b5-4c6d-9e0f-1a2b3c4d5e6f
OPENMRS_DEFAULT_LOCATION_UUID=44c3efb0-2583-4c80-a79e-1f756a03c0a1
OPENMRS_FHIR_EXTENSION_URL=http://fhir.openmrs.org/ext/patient/identifier#location
# Encounter type used to anchor order-less (Odoo-billed / walk-in) lab results that CIS ingests
# from OpenELIS into OpenMRS. Default = the stock "Lab Results" encounter type.
OPENMRS_LAB_RESULTS_ENCOUNTER_TYPE_UUID=3596fafb-6f6f-4396-8c87-6e63a0f1bd71
# Concept set whose members O3's order basket lists as orderable lab tests. The CIS lab-catalog
# sync adds each newly-synced test concept to this set so it becomes orderable in OpenMRS.
OPENMRS_LAB_ORDERABLES_CONCEPT_SET_UUID=1748a953-d12e-4be1-914c-f6b096c6cdef

# ── Integration sync service account (bidirectional-sync LOOP PREVENTION) ───────────────
# A single dedicated account provisioned by the middleware on startup — CIS creates it in OpenMRS
# + OpenELIS, OIS in Odoo — with full privileges. The middleware writes as this account; each
# system recognises and suppresses its own sync-writes instead of echoing them back (loop
# prevention). CHANGE THE PASSWORD before deploy.
NIDAN_SYNC_USERNAME=admin
NIDAN_SYNC_PASSWORD=Admin123

# order_type UUIDs (Initializer configuration/ordertypes/ordertypes.csv). CIS resolves to order_type_id at startup.
OPENMRS_ORDER_TYPE_UUID_DRUG=131168f4-15f5-102d-96e4-000c29c2a5d7
OPENMRS_ORDER_TYPE_UUID_LAB=52a447d3-a64a-11e3-9aeb-50e549534c5e
OPENMRS_ORDER_TYPE_UUID_RADIOLOGY=c19c8e82-8b8d-4b4e-b1ff-3f09890b2db3
OPENMRS_ORDER_TYPE_UUID_PROCEDURE=4237a01f-29c5-4167-9d8e-96d6e590aa33
OPENMRS_ORDER_TYPE_UUID_MEDICAL_SUPPLY=dab3ab30-2feb-48ec-b4af-8332a0831b49
# Optional until CIS handles bed orders:
OPENMRS_ORDER_TYPE_UUID_BED=e8c4fd91-4b0a-4f2c-9d8e-1a2b3c4d5e6f

# OpenMRS O3 SPA image build (nidan-docker/openmrs/frontend/Dockerfile)
# Default Dockerfile includes @nidan/esm-nepali-calendar (BS calendar).
# For vanilla upstream date pickers: docker build -f Dockerfile.vanilla ...
# NIDAN_CALENDAR_BUNDLE=1.0.0-v9   # bump Dockerfile ARG after repacking the tgz

# -----------------------------------------------------------------------------
# Orthanc — PostgreSQL + DICOM server (HTTP basic for Orthanc UI / CIS)
# -----------------------------------------------------------------------------
ORTHANC_DB_NAME=orthanc
ORTHANC_DB_USER=orthanc
ORTHANC_DB_PASSWORD=orthanc
ORTHANC_DB_HOST=orthanc-db
ORTHANC_USERNAME=nidan
ORTHANC_PASSWORD=nidan
ORTHANC_DICOM_UID_ROOT=1.2.840.10008
# Web UI (host browser): http://localhost:8042/ — use HTTP Basic with ORTHANC_USERNAME / ORTHANC_PASSWORD.
# Via gateway (port 80): http://localhost/orthanc-container/ui/app/ — requires gateway container up; same Basic auth.
# Do not open http://orthanc:8042 on your laptop; that hostname only resolves inside Docker.
# Orthanc Explorer 2: try .../ui/app/ or .../app/ if the root URL is blank.
# If the page stays empty, open DevTools → Network: a 401 means you must sign in (browser login prompt).

# -----------------------------------------------------------------------------
# OpenELIS — app + DB + CIS REST client
# -----------------------------------------------------------------------------
OPENELIS_DOMAIN=localhost
OPENELIS_DB_NAME=clinlims
OPENELIS_DB_USER=clinlims
OPENELIS_DB_PASSWORD=clinlims
OPENELIS_DEFAULT_ADMIN_PASSWORD=adminADMIN!
OPENELIS_TZ=UTC

# nidan-cis → OpenELIS-Global REST
OPENELIS_ENABLED=true
OPENELIS_BASE_URL=http://openelis:8080/OpenELIS-Global/rest
OPENELIS_USERNAME=admin
OPENELIS_PASSWORD=adminADMIN!

# OpenELIS ← CIS middleware sync (JVM -D props injected via CATALINA_OPTS)
CIS_BASE_URL=http://nidan-cis:8081
OPENELIS_MIDDLEWARE_TEST_SYNC_ENABLED=false
OPENELIS_MIDDLEWARE_RESULT_SYNC_ENABLED=true
OPENELIS_NIDAN_TESTORDER_ENABLED=true
OPENELIS_MIDDLEWARE_SYNC_SECRET=ChangeMe-Sync-Secret-123!

# Nidan Paywall — set ENABLED=true for hospitals with Odoo billing.
OPENELIS_NIDAN_PAYWALL_ENABLED=true
NIDANCORE_ODOO_URL=http://odoo:8069
OPENELIS_NIDAN_PAYWALL_INSURANCE_BYPASS=true

# -----------------------------------------------------------------------------
# Odoo — PostgreSQL + app + OIS bridge
# -----------------------------------------------------------------------------
ODOO_DB_NAME=nidan
ODOO_DB_USER=nidan
ODOO_DB_PASSWORD=nidan
ODOO_POSTGRES_USER=odoo
ODOO_POSTGRES_PASSWORD=odoo
ODOO_POSTGRES_DB=postgres
ODOO_DB_HOST=odoo-db
ODOO_DB_PORT=5432
ODOO_ADMIN_EMAIL=nidan
ODOO_ADMIN_PASSWORD=nidan
ODOO_WEB_BASE_URL=http://localhost:8069
ODOO_WEB_BASE_URL_FREEZE=True

# Odoo image. Prod compose pulls this. Open-source base by default; for hospital
# deployments set the private image that bakes the closed-source addons, e.g.:
#   ODOO_IMAGE=trigonaltechnology/nidan_odoo_pro:stable
ODOO_IMAGE=trigonaltechnology/nidan_odoo:stable

# Dev-only addon source mounts (dev.docker-compose.yml). Prod uses baked image addons.
#   ODOO_EXTRA_ADDONS_HOST_PATH  -> open-source addons   -> /mnt/extra-addons
#   ODOO_PRIVATE_ADDONS_HOST_PATH-> closed-source addons -> /mnt/private-addons
ODOO_EXTRA_ADDONS_HOST_PATH=../odoo_19_addons
ODOO_PRIVATE_ADDONS_HOST_PATH=../nidan_odoo_extra_addons

# OIS URL/secret (Odoo module + echoed on nidan-ois). If you change OIS_PORT, update the URL.
NIDAN_OIS_URL=http://nidan-ois:8082
NIDAN_OIS_SECRET=sample

# nidan-ois → Odoo JSON-RPC (database name must match ODOO_DB_NAME)
ODOO_USERNAME=admin
ODOO_PASSWORD=admin
# Radiology accession / procedure code prefixes: set on CIS (OpenMRS → MWL), not Odoo:
#   RADIOLOGY_ACCESSION_PREFIX, RADIOLOGY_PROCEDURE_CODE_PREFIX (see CIS service env below).

# Shared secrets: keep Odoo and OIS values aligned (NIDAN_OIS_SECRET ↔ Odoo module config).
NIDAN_ODOO_SECRET=c3d25bf6-1b3d-4565-919a-662528f6909a
ODOO_NIDAN_SECRET=b52ec053-f343-4bdc-b53e-40734573f0c5
OIS_WEBHOOK_SECRET=79d0e01f-cd94-4f64-bf68-bca4046b329b

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_RELATIVE_PATH=/auth

# -----------------------------------------------------------------------------
# Nidan middleware PostgreSQL (CIS + OIS)
# -----------------------------------------------------------------------------
INTEGRATION_DB_NAME=nidan_integration
INTEGRATION_DB_USER=nidan
INTEGRATION_DB_PASSWORD=nidan
INTEGRATION_DB_HOST=nidan-integration-db
INTEGRATION_DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis — visit sync echo lock (CIS + OIS spring.data.redis); optional if compose has no Redis.
# MANAGEMENT_HEALTH_REDIS_ENABLED=false avoids actuator Redis health WARNs when broker is down/absent.
# Set true when Redis is deployed and you want readiness to reflect Redis; align REDIS_HOST / REDIS_PORT.
# -----------------------------------------------------------------------------
MANAGEMENT_HEALTH_REDIS_ENABLED=false

# -----------------------------------------------------------------------------
# Zookeeper & Kafka
# -----------------------------------------------------------------------------
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_ZOOKEEPER_CONNECT=nidan-zookeeper:2181
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_MIN_INSYNC_REPLICAS=1

# Optional: broker / ZooKeeper JVM and threading (docker-compose nidan-kafka / nidan-zookeeper).
# Defaults are set in docker-compose.yml; override only if you hit OOM or many consumer groups.
# KAFKA_HEAP_OPTS=-Xmx768m -Xms768m
# KAFKA_JVM_PERFORMANCE_OPTS=-XX:+UseG1GC -XX:MaxGCPauseMillis=20 -XX:+ExitOnOutOfMemoryError
# ZOOKEEPER_HEAP_OPTS=-Xmx256m -Xms256m
# KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=3000
# KAFKA_NUM_NETWORK_THREADS=8
# KAFKA_NUM_IO_THREADS=8

# Optional: Spring Kafka client timeouts (CIS/OIS application.yml). Uncomment to tune without rebuild.
# KAFKA_CONSUMER_REQUEST_TIMEOUT_MS=120000
# KAFKA_CONSUMER_SESSION_TIMEOUT_MS=45000
# KAFKA_CONSUMER_HEARTBEAT_INTERVAL_MS=15000
# KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=120000
# KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# CIS (nidan-cis) — image, ports, feature toggles & integration targets
# Local build: ../nidan-middleware/integration — or set registry images, e.g.
#   NIDAN_CIS_IMAGE=trigonaltechnology/nidan-cis:latest
# -----------------------------------------------------------------------------
NIDAN_CIS_IMAGE=nidan-cis:local
CIS_PORT=8081
CIS_KAFKA_GROUP_ID=nidan-cis
# Optional JVM truststore for HTTPS (regenerate: scripts/create-gateway-truststore.sh)
# CIS_JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/etc/ssl/certs/gateway-truststore.p12 -Djavax.net.ssl.trustStorePassword=gatewayTrust123 -Djdk.internal.httpclient.disableHostnameVerification=true

OPENMRS_ENABLED=true
OPENMRS_BASE_URL=http://openmrs-backend:8080/openmrs
ORTHANC_ENABLED=true
ORTHANC_BASE_URL=http://orthanc:8042
# MWL .wl output; compose must mount ./orthanc/worklists → this path
ORTHANC_WORKLIST_DIR=/var/lib/orthanc/worklists
DICOM_TYPE=orthanc

INTEGRATION_SOURCE_SYSTEM=CIS
INTEGRATION_SKIP_SOURCE_SYSTEMS=OPENMRS
RADIOLOGY_ACCESSION_PREFIX=RAD-
RADIOLOGY_PROCEDURE_CODE_PREFIX=RAD-

# integration.flows.* — false skips that workflow (Kafka consumers still run).
# radiology-mwl: MWL, Orthanc webhook, Orthanc REST (CIS).
# radiology-pos: Odoo POS for radiology (OIS).
# lab-openelis / lab-pos: lab to OpenELIS (CIS) and lab POS (OIS).
# lab-results-openmrs: OpenELIS → OpenMRS result ingestion (CIS). Leave UNSET to follow
#   OPENMRS_ENABLED (auto-off for lab+billing-only deployments with no OpenMRS); set
#   explicitly to override. Pair with OPENELIS_MIDDLEWARE_RESULT_SYNC_ENABLED (source side).
# debezium-publish.*: only when DEBEZIUM_ENABLED=true (CIS embedded → Kafka).
INTEGRATION_FLOW_RADIOLOGY_MWL_ENABLED=true
INTEGRATION_FLOW_RADIOLOGY_POS_ENABLED=true
INTEGRATION_FLOW_LAB_OPENELIS_ENABLED=true
INTEGRATION_FLOW_LAB_POS_ENABLED=true
# INTEGRATION_FLOW_LAB_RESULTS_OPENMRS_ENABLED=true
INTEGRATION_FLOW_DEBEZIUM_PUBLISH_ORDERS_LAB_ENABLED=true
INTEGRATION_FLOW_DEBEZIUM_PUBLISH_ORDERS_RADIOLOGY_ENABLED=true

DEBEZIUM_ENABLED=true
DEBEZIUM_DB_USER=root
DEBEZIUM_DB_PASSWORD=openmrs
DEBEZIUM_TABLE_INCLUDE_LIST=openmrs.visit,openmrs.orders,openmrs.drug_order,openmrs.person,openmrs.person_name,openmrs.patient_identifier,openmrs.bed_type,openmrs.bed_patient_assignment_map,openmrs.location,openmrs.provider,openmrs.provider_attribute

INTEGRATION_KAFKA_RETRY_ENABLED=true
INTEGRATION_KAFKA_RETRY_ATTEMPTS=5
INTEGRATION_KAFKA_RETRY_INITIAL_DELAY=5s
INTEGRATION_KAFKA_RETRY_MULTIPLIER=2.0
INTEGRATION_KAFKA_RETRY_MAX_DELAY=10m
CIS_INTEGRATION_KAFKA_RETRY_TOPIC_SUFFIX=-cis-retry
CIS_INTEGRATION_KAFKA_RETRY_DLT_SUFFIX=.cis.DLT

# -----------------------------------------------------------------------------
# OIS (nidan-ois)
# -----------------------------------------------------------------------------
NIDAN_OIS_IMAGE=nidan-ois:local
OIS_PORT=8082
OIS_KAFKA_GROUP_ID=nidan-ois
ODOO_BASE_URL=http://odoo:8069
SKIP_SOURCE_SYSTEMS_FOR_ODOO=ODOO

OIS_INTEGRATION_KAFKA_RETRY_TOPIC_SUFFIX=-ois-retry
OIS_INTEGRATION_KAFKA_RETRY_DLT_SUFFIX=.ois.DLT

# -----------------------------------------------------------------------------
# DHIS2 / Federal HMIS
# -----------------------------------------------------------------------------
DHIS2_APP_PORT=5000
DHIS2_SECRET_KEY=cb35b4c5-5bf3-4337-bb0a-97451ec21f72
DHIS2_DEBUG=false
DHIS2_FLASK_ENV=production
DHIS2_AUTH_PROVIDER=env_file
DHIS2_ADMIN_PASSWORD=changeme
DHIS2_REPORTER_USERNAME=reporter
DHIS2_REPORTER_PASSWORD=pass
DHIS2_DB_CONNECT_TIMEOUT=10
DHIS2_DB_DATE_OVERLAP_BUFFER_DAYS=2

DHIS2_DB_NAME=nidan_dhis2
DHIS2_DB_USER=nidan
DHIS2_DB_PASSWORD=reporter
DHIS2_DB_ROOT_PASSWORD=reporter
DHIS2_DB_HOST=nidan-dhis2-db
DHIS2_DB_PORT=3306

FEDERAL_HMIS_URL=https://hmis.gov.np/hmis
FEDERAL_HMIS_USERNAME=hospitalcode
FEDERAL_HMIS_PASSWORD=change-me
FEDERAL_HMIS_SSL_VERIFY=false
FEDERAL_HMIS_ORG_UNIT=

PROVINCIAL_DHIS2_URL=
PROVINCIAL_DHIS2_USERNAME=
PROVINCIAL_DHIS2_PASSWORD=
PROVINCIAL_DHIS2_SSL_VERIFY=true
PROVINCIAL_DHIS2_ORG_UNIT=

# -----------------------------------------------------------------------------
# Superset (seeds use OPENMRS_DB_*, OPENELIS_DB_*, ODOO_DB_* from above)
# -----------------------------------------------------------------------------
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_LOAD_EXAMPLES=no
SUPERSET_IMAGE=trigonaltechnology/superset:latest
