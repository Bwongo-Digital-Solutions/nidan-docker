<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_uganda_address_hierarchy" model="ir.ui.view">
        <field name="name">res.partner.form.uganda.address.hierarchy</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='country_id']" position="after">
                <group string="Uganda Address" colspan="2">
                    <group>
                        <field name="uganda_region_id" options="{'no_create': True}"/>
                        <field name="uganda_district_id" options="{'no_create': True}"
                               domain="[('level', '=', 'district'), '|', ('parent_id', '=', uganda_region_id), ('parent_id.level', '=', 'country')]"/>
                        <field name="uganda_county_id" options="{'no_create': True}"
                               domain="[('level', '=', 'county'), ('parent_id', '=', uganda_district_id)]"/>
                        <field name="uganda_subcounty_id" options="{'no_create': True}"
                               domain="[('level', '=', 'subcounty'), ('parent_id', '=', uganda_county_id)]"/>
                        <field name="uganda_parish_id" options="{'no_create': True}"
                               domain="[('level', '=', 'parish'), ('parent_id', 'in', [uganda_subcounty_id, uganda_town_council_id, uganda_municipal_division_id, uganda_city_division_id])]"/>
                        <field name="uganda_village_id" options="{'no_create': True}"
                               domain="[('level', '=', 'village'), ('parent_id', '=', uganda_parish_id)]"/>
                    </group>
                    <group>
                        <field name="uganda_city_id" options="{'no_create': True}"/>
                        <field name="uganda_city_division_id" options="{'no_create': True}"
                               domain="[('level', '=', 'city_division'), ('parent_id', '=', uganda_city_id)]"/>
                        <field name="uganda_municipality_id" options="{'no_create': True}"
                               domain="[('level', '=', 'municipality'), ('parent_id', '=', uganda_district_id)]"/>
                        <field name="uganda_municipal_division_id" options="{'no_create': True}"
                               domain="[('level', '=', 'municipal_division'), ('parent_id', '=', uganda_municipality_id)]"/>
                        <field name="uganda_town_council_id" options="{'no_create': True}"
                               domain="[('level', '=', 'town_council'), ('parent_id', '=', uganda_district_id)]"/>
                        <field name="uganda_ward_id" options="{'no_create': True}"
                               domain="[('level', '=', 'ward'), ('parent_id', 'in', [uganda_town_council_id, uganda_municipal_division_id, uganda_city_division_id])]"/>
                        <field name="uganda_zone_id" options="{'no_create': True}"
                               domain="[('level', '=', 'zone'), ('parent_id', '=', uganda_ward_id)]"/>
                    </group>
                    <group>
                        <field name="uganda_landmark" placeholder="Nearby landmark or additional directions"/>
                        <field name="uganda_gps_latitude"/>
                        <field name="uganda_gps_longitude"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
