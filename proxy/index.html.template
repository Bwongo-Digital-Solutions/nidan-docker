        </div>
      </div>

      <!-- Right Side: Powered By & Copyright -->
      <div class="footer-right">
        <span>
          Powered by
          <a href="https://bwongo.site" target="_blank" class="footer-brand-link">
            <img src="proxy/clinicemr-logo.svg" alt="Bwongo Digital Solutions " class="footer-logo">
            <strong>Bwongo Digital Solutions (U) Ltd</strong>
